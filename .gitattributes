# ─── Default: normalize line endings to LF in the repository ─────────────────
* text=auto eol=lf

# ─── Explicitly LF-only (shell scripts, Maven wrapper for Linux containers) ──
*.sh text eol=lf
mvnw text eol=lf

# ─── Windows batch files stay CRLF ───────────────────────────────────────────
*.cmd text eol=crlf
*.bat text eol=crlf

# ─── Binary files: no line-ending conversion ─────────────────────────────────
*.jar binary
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.svg binary
*.woff binary
*.woff2 binary
*.ttf binary
*.eot binary
